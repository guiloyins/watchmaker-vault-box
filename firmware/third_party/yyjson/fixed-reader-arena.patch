+/* Vault uses strict, bounded-depth, in-situ complete-document parsing.
+   Clamp geometric over-allocation without reducing the valid value capacity.
+   At most half the input bytes plus one can be values in a complete document.
+   For malformed prefixes, reserve one slot per live container (at most 64)
+   and eight additional slots for root, lookahead and partial tokens. */
+#if defined(YYJSON_VAULT_FIXED_ARENA)
+#define yyjson_fixed_arena_growth() do { \
+    usize fixed_limit = hdr_len + dat_len / 2 + 72; \
+    alc_len = yyjson_min(alc_len, fixed_limit); \
+    if (alc_len <= alc_old) goto fail_alloc; \
+} while (false)
+#else
+#define yyjson_fixed_arena_growth() ((void)0)
+#endif
+
 /** Read JSON document (accept all style, but optimized for minify). */
