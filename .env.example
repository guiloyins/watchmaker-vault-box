# M1 operational settings; M0 pure checks require none of these.
VAULT_BIND=127.0.0.1
VAULT_PORT=4000
VAULT_ORIGIN=http://localhost:4000
VAULT_DATA_DIR=./data
VAULT_DATABASE=./data/vault.sqlite3
VAULT_SIMULATOR_DATABASE=./data/simulated-box.sqlite3
VAULT_BOX_MODE=simulated
# M1 generates protected credential files; these are paths, never real keys.
VAULT_HOST_KEY_FILE=./secrets/host.key
VAULT_SECRET_KEY_BASE_FILE=./secrets/secret-key-base.key
