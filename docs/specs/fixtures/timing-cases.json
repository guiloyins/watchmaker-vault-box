{
  "fixture_version": 1,
  "time_unit": "milliseconds",
  "clock": "injected server monotonic time",
  "interpretation": [
    "These are domain-test vectors, not WebSocket messages. Expand recurring heartbeats using the same protocol validator as real inputs.",
    "Unless a case overrides it, both roles have current bindings, correct rune selections, an accepted neutral baseline before time zero and a ready armed simulated box.",
    "Auto heartbeats issue a new challenge and immediately sample the current input every 100ms, beginning at zero. Explicit edge samples use the latest challenge and a new input_seq.",
    "At the same timestamp, apply explicit input changes and lease-expiry checks before evaluating a solve; completion must independently check all current deadlines.",
    "Expectation at_ms is relative to the case start. Equality with challenge-issued+400 is expired.",
    "Messages for stale context may be recorded diagnostically but cannot affect the effective input or renew its lease."
  ],
  "defaults": {
    "heartbeat_interval_ms": 100,
    "input_lease_ms": 400,
    "peer_dead_ms": 1500,
    "hold_duration_ms": 2000
  },
  "cases": [
    {
      "id": "hold_exact_boundary",
      "auto_heartbeats": true,
      "timeline": [
        {
          "at_ms": 0,
          "action": "press",
          "role": "a",
          "press_id": 1
        },
        {
          "at_ms": 0,
          "action": "press",
          "role": "b",
          "press_id": 1
        }
      ],
      "expectations": [
        {
          "at_ms": 1999,
          "phase": "seal",
          "release_intents": 0
        },
        {
          "at_ms": 2000,
          "phase": "solved",
          "release_intents": 1
        },
        {
          "at_ms": 2100,
          "inject": "duplicate_completion_timer",
          "release_intents": 1
        }
      ]
    },
    {
      "id": "staggered_overlap",
      "auto_heartbeats": true,
      "timeline": [
        {
          "at_ms": 0,
          "action": "press",
          "role": "a",
          "press_id": 1
        },
        {
          "at_ms": 350,
          "action": "press",
          "role": "b",
          "press_id": 1
        }
      ],
      "expectations": [
        {
          "at_ms": 2349,
          "phase": "seal",
          "release_intents": 0
        },
        {
          "at_ms": 2350,
          "phase": "solved",
          "release_intents": 1
        }
      ]
    },
    {
      "id": "release_just_before_completion",
      "auto_heartbeats": true,
      "timeline": [
        {
          "at_ms": 0,
          "action": "press",
          "role": "a",
          "press_id": 1
        },
        {
          "at_ms": 0,
          "action": "press",
          "role": "b",
          "press_id": 1
        },
        {
          "at_ms": 1999,
          "action": "release",
          "role": "b"
        }
      ],
      "expectations": [
        {
          "at_ms": 1999,
          "hold_active": false,
          "hold_elapsed_ms": 0
        },
        {
          "at_ms": 2000,
          "inject": "old_completion_timer",
          "phase": "seal",
          "release_intents": 0
        }
      ]
    },
    {
      "id": "lease_expiry_wins_tie",
      "auto_heartbeats": true,
      "stop_role_heartbeat_after_ms": {
        "b": 1600
      },
      "timeline": [
        {
          "at_ms": 0,
          "action": "press",
          "role": "a",
          "press_id": 1
        },
        {
          "at_ms": 0,
          "action": "press",
          "role": "b",
          "press_id": 1
        },
        {
          "at_ms": 1650,
          "action": "physical_release_not_delivered",
          "role": "b"
        }
      ],
      "expectations": [
        {
          "at_ms": 1999,
          "phase": "seal",
          "hold_active": true
        },
        {
          "at_ms": 2000,
          "phase": "seal",
          "hold_active": false,
          "release_intents": 0
        },
        {
          "at_ms": 3100,
          "paused": true,
          "pause_reasons": [
            "controller_offline",
            "recovery"
          ]
        }
      ]
    },
    {
      "id": "late_challenge_does_not_extend_lease",
      "auto_heartbeats": false,
      "given": {
        "both_pressed": true,
        "latest_challenge_issue_ms": 0
      },
      "timeline": [
        {
          "at_ms": 399,
          "action": "sample",
          "role": "a",
          "challenge_issued_ms": 0,
          "input_seq": 2,
          "pressed": true,
          "press_id": 1
        }
      ],
      "expectations": [
        {
          "at_ms": 399,
          "input_accepted": true,
          "lease_deadline_ms": 400
        },
        {
          "at_ms": 400,
          "hold_active": false,
          "fresh_press_required": true
        }
      ]
    },
    {
