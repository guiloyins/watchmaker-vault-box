        },
        {
          "at_ms": 20,
          "action": "sample",
          "role": "a",
          "heartbeat_seq": 10,
          "input_seq": 101,
          "pressed": false,
          "press_id": null
        },
        {
          "at_ms": 30,
          "action": "sample",
          "role": "a",
          "heartbeat_seq": 10,
          "input_seq": 102,
          "pressed": true,
          "press_id": 8
        }
      ],
      "expectations": [
        {
          "at_ms": 10,
