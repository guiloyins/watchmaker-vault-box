          "role_held": true
        }
      ]
    },
    {
      "id": "pause_keeps_choices_clears_attempt",
      "auto_heartbeats": true,
      "timeline": [
        {
          "at_ms": 0,
          "action": "press",
          "role": "a",
          "press_id": 1
        },
        {
          "at_ms": 0,
          "action": "press",
          "role": "b",
          "press_id": 1
        },
        {
          "at_ms": 1500,
          "action": "host_pause"
        },
        {
          "at_ms": 1600,
          "action": "old_epoch_pressed_sample",
          "role": "a"
        }
      ],
      "expectations": [
        {
          "at_ms": 1500,
          "paused": true,
          "phase": "seal",
          "selected_runes": {
            "a": "star",
            "b": "moon"
          },
          "hold_active": false
