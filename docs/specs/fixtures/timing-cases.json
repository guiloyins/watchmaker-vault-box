          "at_ms": 2000,
          "inject": "old_completion_timer",
          "release_intents": 0
        }
      ]
    },
    {
      "id": "observer_disconnect_does_not_pause",
      "auto_heartbeats": true,
      "given": {
        "owners": {
          "a": "cyd",
          "b": "cyd"
        }
      },
      "timeline": [
        {
          "at_ms": 100,
          "action": "disconnect_host_observer"
        }
      ],
      "expectations": [
        {
          "at_ms": 101,
          "paused": false,
          "owners_unchanged": true
        }
      ]
    },
    {
      "id": "recovery_does_not_resume_old_hold",
      "auto_heartbeats": false,
      "timeline": [
        {
          "at_ms": 0,
          "action": "game_session_restart"
        },
        {
          "at_ms": 10,
          "action": "deliver_old_connection_sample"
        },
        {
          "at_ms": 20,
          "action": "reconnect_and_authenticate"
        },
        {
          "at_ms": 30,
          "action": "deliver_old_completion_timer"
        }
      ],
      "expectations": [
        {
          "at_ms": 0,
          "new_session_id": true,
          "paused": true,
          "all_leases_cleared": true,
          "raw_close_code": 4003
        },
        {
          "at_ms": 30,
          "paused": true,
          "release_intents_added": 0
        }
      ]
    }
  ]
}
